---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../config/business';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${business.brand.name} · Platillo del día en ${business.brand.city}`,
  description = 'Pide el platillo del día en Los Jiménez, Playa del Carmen. Comida casera, entrega a domicilio y pago en efectivo o transferencia.',
} = Astro.props;

const ogImage = '/images/dish-today.jpg';
const robots = business.seo.indexable ? 'index, follow' : 'noindex, nofollow';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3d4a32" />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={`${business.brand.name} · ${business.brand.tagline}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Outfit:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-cream font-sans text-ink">
    <a
      href="#contenido"
      class="sr-only z-[100] rounded-full bg-ink px-5 py-3 text-sm font-semibold text-cream focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Saltar al contenido
    </a>

    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
