---
import { Image } from 'astro:assets';
import { ArrowRight, Images } from '@lucide/astro';
import DemoNotice from '../components/DemoNotice.astro';
import PageHeader from '../components/PageHeader.astro';
import Layout from '../layouts/Layout.astro';
import { business } from '../config/business';
import { galleryImages } from '../data/gallery';
---

<Layout
  title={`Galería · ${business.brand.name}`}
  description={`Galería de ${business.brand.name}: la cocina, los platillos y los ingredientes de nuestra comida casera en ${business.brand.city}.`}
>
  <PageHeader
    eyebrow="Galería"
    title="La cocina, de cerca"
    accent="cerca"
    description="Un vistazo a lo que se cocina, se prueba y se comparte en Los Jiménez. Comida sencilla, hecha con calma y con ingredientes frescos."
  >
    <Images slot="icon" class="size-4" aria-hidden="true" />
  </PageHeader>

  <section class="container-page pb-14 sm:pb-20">
    <DemoNotice
      class="mt-7"
      message="Las fotografías de esta galería son imágenes de demostración de Unsplash. Cuando tengamos las fotos reales de la cocina y los platillos, ocuparán este mismo espacio."
    />

    <div class="mt-8 columns-1 gap-5 sm:columns-2 lg:columns-3">
      {
        galleryImages.map((image) => (
          <figure class="mb-5 break-inside-avoid overflow-hidden rounded-[1.5rem] border border-line bg-paper shadow-card">
            <Image
              src={image.src}
              alt={image.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-cover"
            />
            <figcaption class="p-4 sm:p-5">
              <div class="flex items-start justify-between gap-3">
                <h2 class="font-display text-lg font-semibold leading-tight text-ink">
                  {image.title}
                </h2>
                <span class="shrink-0 rounded-full bg-cream px-2.5 py-1 text-[9px] font-semibold uppercase tracking-[0.1em] text-brand">
                  {image.category}
                </span>
              </div>
              <p class="mt-1.5 text-xs leading-relaxed text-ink-muted">{image.description}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-6 rounded-[2rem] border border-line bg-paper px-6 py-8 shadow-card sm:px-9">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand">Se te antojó</p>
          <h2 class="mt-1.5 font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
            Hoy se cocina {business.dish.name.toLowerCase()}
          </h2>
          <p class="mt-1.5 text-sm text-ink-muted">
            Pide tu platillo y recíbelo caliente en casa.
          </p>
        </div>
        <a href="/" class="btn-primary shrink-0">
          Pedir hoy
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</Layout>
