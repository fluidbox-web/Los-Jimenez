---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, CalendarDays, Clock } from '@lucide/astro';
import DemoNotice from '../../components/DemoNotice.astro';
import PageHeader from '../../components/PageHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { business } from '../../config/business';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = posts;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-MX', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);

const postUrl = (id: string) => `/blog/${id}`;
---

<Layout
  title={`Blog · ${business.brand.name}`}
  description={`Historias, recetas y novedades de la cocina de ${business.brand.name} en ${business.brand.city}.`}
>
  <PageHeader
    eyebrow="Blog"
    title="Historias de la cocina"
    accent="cocina"
    description="Recetas, ingredientes y pequeñas historias de lo que pasa todos los días en Los Jiménez."
  >
    <BookOpen slot="icon" class="size-4" aria-hidden="true" />
  </PageHeader>

  <section class="container-page pb-14 sm:pb-20">
    <DemoNotice
      class="mt-7"
      message="Los artículos de este blog son contenido de demostración. Sirven para mostrar el diseño y la estructura editorial del sitio."
    />

    {
      featured && (
        <a
          href={postUrl(featured.id)}
          class="group mt-8 grid overflow-hidden rounded-[2rem] border border-line bg-paper shadow-card transition duration-300 hover:-translate-y-0.5 hover:shadow-float lg:grid-cols-[1.05fr_0.95fr]"
        >
          <div class="relative min-h-[240px] overflow-hidden bg-cream-deep sm:min-h-[320px]">
            {featured.data.cover ? (
              <Image
                src={featured.data.cover}
                alt={featured.data.coverAlt ?? featured.data.title}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1024px) 52vw, 100vw"
                format="webp"
                quality={85}
                loading="eager"
                decoding="async"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
              />
            ) : (
              <div class="grid h-full min-h-[240px] place-items-center bg-cream-deep text-brand">
                <BookOpen class="size-14" aria-hidden="true" />
              </div>
            )}
            <span class="absolute left-4 top-4 rounded-full bg-paper/95 px-3 py-1.5 text-[9px] font-bold uppercase tracking-[0.14em] text-brand shadow-sm backdrop-blur">
              Último artículo
            </span>
          </div>

          <div class="flex flex-col justify-center p-6 sm:p-9">
            <div class="flex flex-wrap items-center gap-3 text-[11px] text-ink-muted">
              <span class="rounded-full bg-brand-soft/60 px-3 py-1 text-[9px] font-bold uppercase tracking-[0.12em] text-brand-dark">
                {featured.data.tag}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <CalendarDays class="size-3.5" aria-hidden="true" />
                {formatDate(featured.data.pubDate)}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <Clock class="size-3.5" aria-hidden="true" />
                {featured.data.readingTime}
              </span>
            </div>

            <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-ink transition group-hover:text-brand sm:text-4xl">
              {featured.data.title}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{featured.data.description}</p>

            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand">
              Leer artículo
              <ArrowRight class="size-4 transition group-hover:translate-x-0.5" aria-hidden="true" />
            </span>
          </div>
        </a>
      )
    }

    <div class="mt-12 flex flex-wrap items-end justify-between gap-3">
      <div>
        <span class="eyebrow">
          <BookOpen class="size-4" aria-hidden="true" />
          Más historias
        </span>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          Para leer con calma
        </h2>
      </div>
      <p class="text-xs text-ink-muted">
        {rest.length} {rest.length === 1 ? 'artículo' : 'artículos'}
      </p>
    </div>

    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      {
        rest.map((post) => (
          <a
            href={postUrl(post.id)}
            class="group flex flex-col overflow-hidden rounded-[1.5rem] border border-line bg-paper shadow-card transition duration-300 hover:-translate-y-0.5 hover:shadow-float"
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-cream-deep">
              {post.data.cover ? (
                <Image
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? post.data.title}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                />
              ) : (
                <div class="grid h-full place-items-center text-brand">
                  <BookOpen class="size-10" aria-hidden="true" />
                </div>
              )}
              <span class="absolute left-3 top-3 rounded-full bg-paper/95 px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.12em] text-brand shadow-sm backdrop-blur">
                {post.data.tag}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <div class="flex flex-wrap items-center gap-3 text-[11px] text-ink-muted">
                <span>{formatDate(post.data.pubDate)}</span>
                <span class="text-line">·</span>
                <span>{post.data.readingTime}</span>
              </div>
              <h3 class="mt-2 font-display text-xl font-semibold leading-tight text-ink transition group-hover:text-brand">
                {post.data.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
                {post.data.description}
              </p>
              <span class="mt-4 inline-flex items-center gap-2 text-xs font-semibold text-brand">
                Leer artículo
                <ArrowRight class="size-3.5 transition group-hover:translate-x-0.5" aria-hidden="true" />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <p class="mt-8 rounded-2xl border border-line bg-paper p-6 text-sm text-ink-muted">
          Todavía no hay artículos publicados. Vuelve pronto.
        </p>
      )
    }

    <div class="mt-10 rounded-[2rem] bg-olive px-6 py-8 text-cream shadow-card sm:px-9">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-gold">De la cocina a tu mesa</p>
          <h2 class="mt-1.5 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
            Hoy se cocina {business.dish.name.toLowerCase()}
          </h2>
          <p class="mt-1.5 text-sm text-cream/75">
            Pide tu platillo y recíbelo caliente en casa.
          </p>
        </div>
        <a
          href="/"
          class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-full bg-cream px-6 py-3 text-sm font-semibold text-olive-dark transition hover:-translate-y-0.5 hover:bg-white"
        >
          Pedir hoy
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</Layout>
