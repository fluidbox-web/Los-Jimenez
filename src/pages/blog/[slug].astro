---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowRight, CalendarDays, Clock } from '@lucide/astro';
import DemoNotice from '../../components/DemoNotice.astro';
import Layout from '../../layouts/Layout.astro';
import { business } from '../../config/business';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props as Props;
const { Content } = await render(post);

const related = (await getCollection('blog', ({ data, id }) => !data.draft && id !== post.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-MX', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
---

<Layout
  title={`${post.data.title} · ${business.brand.name}`}
  description={post.data.description}
>
  <div class="container-page py-8 sm:py-10">
    <a
      href="/blog"
      class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ink-muted transition hover:text-ink"
    >
      <ArrowLeft class="size-4" aria-hidden="true" />
      Volver al blog
    </a>

    <article class="mx-auto mt-5 max-w-3xl overflow-hidden rounded-[2rem] border border-line bg-paper shadow-card">
      <div class="relative aspect-[16/9] overflow-hidden bg-cream-deep">
        {
          post.data.cover ? (
            <Image
              src={post.data.cover}
              alt={post.data.coverAlt ?? post.data.title}
              widths={[720, 1080, 1440]}
              sizes="(min-width: 768px) 768px, 100vw"
              format="webp"
              quality={86}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="grid h-full place-items-center text-brand">
              <CalendarDays class="size-14" aria-hidden="true" />
            </div>
          )
        }
      </div>

      <div class="p-6 sm:p-9 lg:p-10">
        <div class="flex flex-wrap items-center gap-3 text-[11px] text-ink-muted">
          <span class="rounded-full bg-brand-soft/60 px-3 py-1 text-[9px] font-bold uppercase tracking-[0.12em] text-brand-dark">
            {post.data.tag}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <CalendarDays class="size-3.5" aria-hidden="true" />
            {formatDate(post.data.pubDate)}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Clock class="size-3.5" aria-hidden="true" />
            {post.data.readingTime}
          </span>
        </div>

        <h1 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
          {post.data.title}
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">
          {post.data.description}
        </p>

        <DemoNotice
          class="mt-6"
          message="Este artículo es contenido de demostración. Cuando el sitio esté en producción, aquí aparecerán las historias reales de la cocina."
        />

        <div class="prose-jimenez mt-8">
          <Content />
        </div>

        <div class="mt-10 rounded-2xl border border-line bg-cream/70 p-5 sm:p-6">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand">
            De la cocina a tu mesa
          </p>
          <h2 class="mt-1.5 font-display text-2xl font-semibold tracking-tight text-ink">
            Hoy se cocina {business.dish.name.toLowerCase()}
          </h2>
          <a href="/" class="btn-primary mt-4">
            Pedir el platillo de hoy
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="mx-auto mt-10 max-w-3xl" aria-labelledby="related-title">
          <h2 id="related-title" class="font-display text-2xl font-semibold tracking-tight text-ink">
            Sigue leyendo
          </h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {related.map((relatedPost) => (
              <a
                href={`/blog/${relatedPost.id}`}
                class="group rounded-2xl border border-line bg-paper p-5 transition hover:border-ink/20 hover:shadow-card"
              >
                <span class="text-[9px] font-bold uppercase tracking-[0.12em] text-brand">
                  {relatedPost.data.tag}
                </span>
                <h3 class="mt-2 font-display text-lg font-semibold leading-tight text-ink transition group-hover:text-brand">
                  {relatedPost.data.title}
                </h3>
                <p class="mt-1.5 text-xs leading-relaxed text-ink-muted">
                  {relatedPost.data.description}
                </p>
                <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-brand">
                  Leer artículo
                  <ArrowRight class="size-3.5 transition group-hover:translate-x-0.5" aria-hidden="true" />
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
