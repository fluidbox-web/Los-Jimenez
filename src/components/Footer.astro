---
import { business } from '../config/business';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const year = new Date().getFullYear();
const helpUrl = buildWhatsAppUrl(
  business.whatsapp.number,
  'Hola, tengo una duda sobre el pedido de hoy.',
);
---

<footer class="border-t border-line/70 bg-cream">
  <div class="container-page flex flex-col gap-4 py-7 text-xs text-ink-muted">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
      <p>
        <span class="font-display text-sm font-semibold text-ink">{business.brand.name}</span>
        <span class="mx-2 text-line">·</span>
        {business.brand.city}, {business.brand.state}
        <span class="mx-2 text-line">·</span>
        Precios en MXN
      </p>

      <nav class="flex flex-wrap items-center gap-x-5 gap-y-2" aria-label="Información legal">
        <a href={business.privacy.url} class="inline-flex min-h-11 items-center transition hover:text-ink">
          Aviso de privacidad
        </a>
        {
          helpUrl && (
            <a
              href={helpUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center transition hover:text-ink"
            >
              WhatsApp
            </a>
          )
        }
        <span>© {year}</span>
      </nav>
    </div>

    {
      business.demoMode && (
        <p class="border-t border-line/60 pt-3 text-[11px] leading-relaxed text-ink-muted">
          {business.demoNotice}
        </p>
      )
    }
  </div>
</footer>
