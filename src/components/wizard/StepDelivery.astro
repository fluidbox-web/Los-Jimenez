---
import { ArrowLeft, Bookmark, Clock, MapPin, Trash } from '@lucide/astro';
import { business } from '../../config/business';

const zones = business.coverage.zones.filter((zone) => zone.enabled);
const windows = business.deliveryWindows.options.filter((window) => window.enabled);
---

<section
  data-step-panel="3"
  hidden
  aria-labelledby="delivery-title"
  class="wizard-panel"
>
  <div class="mb-5 flex items-center justify-between gap-3">
    <button type="button" data-back class="step-back">
      <ArrowLeft class="size-4" aria-hidden="true" />
      Volver
    </button>
    <span class="eyebrow">Paso 3 · Entrega</span>
  </div>
  <h2
    id="delivery-title"
    data-step-heading
    tabindex="-1"
    class="mt-3 font-display text-4xl font-semibold leading-[1.02] tracking-tight text-ink sm:text-5xl"
  >
    ¿A dónde lo <em class="italic text-brand">llevamos</em>?
  </h2>
  <p class="mt-3 max-w-lg text-sm leading-relaxed text-ink-muted sm:text-base">
    Necesitamos tu WhatsApp y tu dirección para coordinar la entrega. Los campos con * son
    obligatorios.
  </p>

  <div class="mt-5 rounded-2xl border border-line/80 bg-cream-deep/45 p-4">
    <p class="flex items-start gap-2 text-[11px] leading-relaxed text-ink-muted sm:text-xs">
      <MapPin class="mt-0.5 size-4 shrink-0 text-brand" aria-hidden="true" />
      <span>{business.coverage.statement}</span>
    </p>
  </div>

  <div data-saved-addresses hidden class="mt-5 rounded-2xl border border-line bg-paper p-4 shadow-card">
    <div class="flex items-center justify-between gap-3">
      <p class="flex items-center gap-2 text-xs font-semibold text-ink">
        <Bookmark class="size-4 text-brand" aria-hidden="true" />
        Direcciones anteriores
      </p>
      <button type="button" data-forget-addresses class="btn-quiet !min-h-11 !px-2 text-[11px]">
        <Trash class="size-3.5" aria-hidden="true" />
        Olvidar
      </button>
    </div>
    <div data-saved-address-list class="mt-3 grid gap-2"></div>
    <p class="mt-2 text-[10px] leading-relaxed text-ink-muted">
      Solo se guardan en este dispositivo si tú lo autorizas.
    </p>
  </div>

  <div data-delivery-form class="mt-6 space-y-4">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="customer-name" class="field-label">
          Nombre <span class="font-normal text-ink-muted">(opcional)</span>
        </label>
        <input
          id="customer-name"
          type="text"
          name="name"
          autocomplete="name"
          maxlength="80"
          placeholder="Ej. Ana López"
          class="field"
        />
        <p data-error-for="name" class="field-error" hidden></p>
      </div>

      <div>
        <label for="customer-phone" class="field-label">WhatsApp *</label>
        <div data-phone-shell class="input-shell">
          <span class="input-prefix" aria-hidden="true">+52</span>
          <input
            id="customer-phone"
            type="tel"
            name="phone"
            inputmode="tel"
            autocomplete="tel-national"
            placeholder="984 123 4567"
            maxlength="24"
            aria-describedby="phone-help phone-error"
            required
          />
        </div>
        <p id="phone-help" class="field-help">Solo números de México. Te escribimos a este número.</p>
        <p id="phone-error" data-error-for="phone" class="field-error" hidden></p>
      </div>
    </div>

    <div>
      <label for="customer-zone" class="field-label">Colonia *</label>
      <select
        id="customer-zone"
        name="zoneId"
        autocomplete="address-level3"
        class="field"
        aria-describedby="zone-help zone-error"
        required
      >
        <option value="">Elige tu colonia</option>
        {zones.map((zone) => <option value={zone.id} data-estimate={zone.estimate ?? ''}>{zone.name}</option>)}
        <option value="not-covered">Mi colonia no aparece</option>
      </select>
      <p id="zone-help" class="field-help">
        {business.demoMode ? business.coverage.demoNote : 'Si tu colonia no aparece, escríbenos por WhatsApp.'}
      </p>
      <p
        data-zone-note
        hidden
        class="mt-2 flex items-start gap-2 rounded-xl bg-cream px-3 py-2 text-[11px] leading-relaxed text-ink-muted"
        aria-live="polite"
      >
        <Clock class="mt-0.5 size-3.5 shrink-0 text-brand" aria-hidden="true" />
        <span data-zone-note-text></span>
      </p>
      <p id="zone-error" data-error-for="zoneId" class="field-error" hidden></p>
    </div>

    <div>
      <label for="customer-street" class="field-label">Calle y número *</label>
      <input
        id="customer-street"
        type="text"
        name="street"
        autocomplete="address-line1"
        maxlength="120"
        placeholder="Ej. Av. 10 Norte 245"
        class="field"
        aria-describedby="street-error"
        required
      />
      <p id="street-error" data-error-for="street" class="field-error" hidden></p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="customer-address-extra" class="field-label">
          Negocio, edificio, piso o depto.{' '}
          <span class="font-normal text-ink-muted">(opcional)</span>
        </label>
        <input
          id="customer-address-extra"
          type="text"
          name="addressExtra"
          autocomplete="address-line2"
          maxlength="120"
          placeholder="Ej. Edificio Coral, depto. 3B"
          class="field"
        />
        <p data-error-for="addressExtra" class="field-error" hidden></p>
      </div>

      <div>
        <label for="customer-references" class="field-label">
          Referencias <span class="font-normal text-ink-muted">(opcional)</span>
        </label>
        <input
          id="customer-references"
          type="text"
          name="references"
          maxlength="240"
          placeholder="Ej. Portón verde frente al parque"
          class="field"
        />
        <p data-error-for="references" class="field-error" hidden></p>
      </div>
    </div>

    {
      business.deliveryWindows.enabled && (
        <div>
          <label for="delivery-window" class="field-label">
            Horario de entrega {business.deliveryWindows.required ? '*' : '(opcional)'}
          </label>
          <select
            id="delivery-window"
            name="deliveryWindowId"
            class="field"
            aria-describedby="window-help window-error"
            required={business.deliveryWindows.required}
          >
            {
              windows.map((window) => (
                <option
                  value={window.id}
                  selected={window.id === business.deliveryWindows.defaultWindowId}
                >
                  {window.label}
                </option>
              ))
            }
          </select>
          <p id="window-help" class="field-help">{business.deliveryWindows.helpText}</p>
          <p id="window-error" data-error-for="deliveryWindowId" class="field-error" hidden></p>
        </div>
      )
    }

    <div data-save-address-wrap class="space-y-2">
      <label class="flex min-h-11 cursor-pointer items-start gap-2.5 rounded-xl bg-paper/70 px-3 py-3 text-xs leading-relaxed text-ink-muted">
        <input
          type="checkbox"
          data-save-address
          class="mt-0.5 size-4 shrink-0 rounded border-line text-brand accent-brand focus:ring-brand"
        />
        <span>Guardar esta dirección en este dispositivo para mi próxima visita.</span>
      </label>
      <p class="text-[10px] leading-relaxed text-ink-muted">
        Se guarda solo en este navegador. Puedes eliminarla con “Olvidar” cuando quieras.
      </p>
    </div>
  </div>
</section>
