---
import { ArrowLeft, Banknote, Info, Landmark } from '@lucide/astro';
import { business } from '../../config/business';
import { calculateTotals, formatMXN } from '../../lib/pricing';

const initialTotals = calculateTotals(
  1,
  business.pricing.unitPrice,
  business.pricing.shippingFee,
);
---

<section
  data-step-panel="4"
  hidden
  aria-labelledby="payment-title"
  class="wizard-panel"
>
  <div class="mb-5 flex items-center justify-between gap-3">
    <button type="button" data-back class="step-back">
      <ArrowLeft class="size-4" aria-hidden="true" />
      Volver
    </button>
    <span class="eyebrow">Paso 4 · Pago</span>
  </div>
  <h2
    id="payment-title"
    data-step-heading
    tabindex="-1"
    class="mt-3 font-display text-4xl font-semibold leading-[1.02] tracking-tight text-ink sm:text-5xl"
  >
    ¿Cómo quieres <em class="italic text-brand">pagar</em>?
  </h2>
  <p class="mt-3 max-w-lg text-sm leading-relaxed text-ink-muted sm:text-base">
    Elige una opción. No aceptamos tarjeta ni cobramos recargos.
  </p>

  <div data-payment-form class="mt-6">
    <fieldset aria-describedby="payment-error">
      <legend class="sr-only">Método de pago</legend>

      <div class="space-y-3">
        <label class="choice-card">
          <input
            type="radio"
            name="paymentMethod"
            value="transfer"
            data-payment-method
            class="sr-only"
          />
          <span class="choice-dot" aria-hidden="true"></span>
          <span class="min-w-0">
            <span class="flex items-center gap-2 font-display text-lg font-semibold text-ink">
              <Landmark class="size-5 text-brand" aria-hidden="true" />
              Transferencia bancaria
            </span>
            <span class="mt-1 block text-xs leading-relaxed text-ink-muted">
              Los datos para transferir aparecerán al registrar tu pedido. El pago queda pendiente
              hasta que lo verifiquemos.
            </span>
          </span>
        </label>

        <label class="choice-card">
          <input
            type="radio"
            name="paymentMethod"
            value="cash"
            data-payment-method
            class="sr-only"
          />
          <span class="choice-dot" aria-hidden="true"></span>
          <span class="min-w-0">
            <span class="flex items-center gap-2 font-display text-lg font-semibold text-ink">
              <Banknote class="size-5 text-brand" aria-hidden="true" />
              Efectivo
            </span>
            <span class="mt-1 block text-xs leading-relaxed text-ink-muted">
              {business.payments.cash.note}
            </span>
          </span>
        </label>
      </div>
    </fieldset>

    <p id="payment-error" data-error-for="payment" class="field-error" hidden></p>

    <div
      data-transfer-details
      hidden
      class="mt-4 rounded-2xl border border-line/80 bg-cream-deep/45 p-4 text-xs leading-relaxed text-ink-muted"
    >
      <p class="flex items-start gap-2">
        <Info class="mt-0.5 size-4 shrink-0 text-brand" aria-hidden="true" />
        <span>{business.payments.transfer.note}</span>
      </p>
    </div>

    <div data-cash-details hidden class="mt-4 rounded-2xl border border-line bg-paper p-4 sm:p-5">
      <p class="font-display text-lg font-semibold text-ink">¿Con cuánto vas a pagar?</p>

      <fieldset class="mt-3">
        <legend class="sr-only">Forma de pago en efectivo</legend>
        <div class="flex flex-wrap gap-2">
          <label class="choice-card-sm">
            <input type="radio" name="cashMode" value="exact" class="sr-only" checked />
            Importe exacto
          </label>
          <label class="choice-card-sm">
            <input type="radio" name="cashMode" value="custom" class="sr-only" />
            Otra cantidad
          </label>
        </div>
      </fieldset>

      <div data-cash-custom hidden class="mt-4">
        <label for="cash-amount" class="field-label">Cantidad en efectivo</label>
        <div class="input-shell max-w-[240px]">
          <span class="input-prefix" aria-hidden="true">$</span>
          <input
            id="cash-amount"
            type="text"
            name="cashAmount"
            inputmode="numeric"
            autocomplete="off"
            placeholder="Ej. 500"
            aria-describedby="cash-total cash-error"
          />
        </div>
        <p id="cash-total" class="field-help">
          Total a cubrir: <strong class="font-semibold text-ink" data-cash-total>{formatMXN(initialTotals.total)}</strong>
        </p>
        <p id="cash-error" data-error-for="cash" class="field-error" hidden></p>
        <p data-cash-change hidden class="mt-2 text-xs font-semibold text-success"></p>
      </div>

      <p class="mt-3 text-[11px] leading-relaxed text-ink-muted">
        Si pagas con una cantidad mayor, te damos tu cambio al entregar.
      </p>
    </div>

    <p class="mt-4 flex items-start gap-2 rounded-xl bg-paper/70 px-3 py-2.5 text-[11px] leading-relaxed text-ink-muted">
      <Info class="mt-0.5 size-3.5 shrink-0 text-brand" aria-hidden="true" />
      El pago con transferencia no se marca como recibido hasta verificarlo. El efectivo se cobra
      al entregar el pedido.
    </p>
  </div>
</section>
