---
import { ArrowLeft, Clock, MapPin, Pencil, Phone, ReceiptText, TriangleExclamationPoint } from '@lucide/astro';
import { business } from '../../config/business';
import { calculateTotals, formatMXN } from '../../lib/pricing';

const initialTotals = calculateTotals(1, business.pricing.unitPrice, business.pricing.shippingFee);
---

<section
  data-step-panel="5"
  hidden
  aria-labelledby="review-title"
  class="wizard-panel"
>
  <div class="mb-5 flex items-center justify-between gap-3">
    <button type="button" data-back class="step-back">
      <ArrowLeft class="size-4" aria-hidden="true" />
      Volver
    </button>
    <span class="eyebrow">Paso 5 · Resumen</span>
  </div>
  <h2
    id="review-title"
    data-step-heading
    tabindex="-1"
    class="mt-3 font-display text-4xl font-semibold leading-[1.02] tracking-tight text-ink sm:text-5xl"
  >
    Revisa tu <em class="italic text-brand">pedido</em>
  </h2>
  <p class="mt-3 max-w-lg text-sm leading-relaxed text-ink-muted sm:text-base">
    Verifica que todo esté bien antes de confirmar. Puedes editar cada sección sin perder tus
    datos.
  </p>

  <div class="mt-6 space-y-4">
    <div class="rounded-2xl border border-line bg-paper p-4 shadow-card sm:p-5">
      <div class="flex items-center justify-between gap-3">
        <h3 class="font-display text-lg font-semibold text-ink">Tu platillo</h3>
        <button type="button" data-edit="2" class="btn-quiet !min-h-11 !px-2 text-xs">
          <Pencil class="size-3.5" aria-hidden="true" />
          Editar
        </button>
      </div>

      <div class="mt-3 flex items-center gap-3">
        <img
          src={business.dish.image}
          alt=""
          width="160"
          height="120"
          loading="lazy"
          class="size-16 shrink-0 rounded-xl object-cover"
        />
        <div class="min-w-0 flex-1">
          <p data-review-dish-name class="font-display text-base font-semibold leading-tight text-ink">
            {business.dish.name}
          </p>
          <p class="mt-1 text-xs text-ink-muted">
            <span data-review-quantity>1</span> × {formatMXN(business.pricing.unitPrice)}
          </p>
        </div>
        <p data-review-line-total class="font-display text-lg font-semibold text-ink">
          {formatMXN(business.pricing.unitPrice)}
        </p>
      </div>
    </div>

    <div class="rounded-2xl border border-line bg-paper p-4 shadow-card sm:p-5">
      <div class="flex items-center justify-between gap-3">
        <h3 class="font-display text-lg font-semibold text-ink">Entrega</h3>
        <button type="button" data-edit="3" class="btn-quiet !min-h-11 !px-2 text-xs">
          <Pencil class="size-3.5" aria-hidden="true" />
          Editar
        </button>
      </div>

      <div class="mt-3 space-y-3 text-xs leading-relaxed text-ink-muted">
        <p class="flex items-start gap-2">
          <MapPin class="mt-0.5 size-3.5 shrink-0 text-brand" aria-hidden="true" />
          <span>
            <span data-review-address-1 class="block font-medium text-ink"></span>
            <span data-review-address-2 class="block"></span>
            <span data-review-references-wrap class="block" hidden>
              Referencias: <span data-review-references></span>
            </span>
          </span>
        </p>
        <p class="flex items-center gap-2">
          <Phone class="size-3.5 shrink-0 text-brand" aria-hidden="true" />
          <span data-review-phone></span>
        </p>
        <p class="flex items-start gap-2">
          <Clock class="mt-0.5 size-3.5 shrink-0 text-brand" aria-hidden="true" />
          <span data-review-schedule></span>
        </p>
      </div>
    </div>

    <div class="rounded-2xl border border-line bg-paper p-4 shadow-card sm:p-5">
      <div class="flex items-center justify-between gap-3">
        <h3 class="font-display text-lg font-semibold text-ink">Pago</h3>
        <button type="button" data-edit="4" class="btn-quiet !min-h-11 !px-2 text-xs">
          <Pencil class="size-3.5" aria-hidden="true" />
          Editar
        </button>
      </div>
      <p data-review-payment class="mt-3 text-sm font-semibold text-ink"></p>
      <p data-review-payment-detail class="mt-1 text-xs leading-relaxed text-ink-muted"></p>
    </div>

    <div class="rounded-2xl bg-olive p-4 text-cream shadow-card sm:p-5">
      <div class="flex items-center gap-2">
        <ReceiptText class="size-4 text-gold" aria-hidden="true" />
        <h3 class="font-display text-lg font-semibold">Totales</h3>
      </div>
      <dl class="mt-3 space-y-2 text-sm">
        <div class="summary-row text-cream/70">
          <dt>Platillos (<span data-review-total-quantity>1</span>)</dt>
          <dd data-subtotal class="font-semibold text-cream">{formatMXN(initialTotals.subtotal)}</dd>
        </div>
        <div class="summary-row text-cream/70">
          <dt>Envío por pedido</dt>
          <dd data-shipping class="font-semibold text-cream">{formatMXN(initialTotals.shipping)}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4 border-t border-cream/15 pt-3">
          <dt class="font-display text-lg font-semibold">Total</dt>
          <dd data-total class="font-display text-3xl font-semibold">{formatMXN(initialTotals.total)}</dd>
        </div>
      </dl>
    </div>

    <div class="rounded-2xl border border-line/80 bg-paper/60 p-4">
      <p class="text-[11px] leading-relaxed text-ink-muted">
        {business.privacy.notice}
        <a
          href={business.privacy.url}
          class="ml-1 font-semibold text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand"
        >
          Ver aviso de privacidad
        </a>
      </p>

      <label class="mt-4 flex min-h-11 cursor-pointer items-center gap-2.5 py-1 text-xs leading-relaxed text-ink-muted">
        <input
          type="checkbox"
          data-promotions
          class="size-4 shrink-0 rounded border-line text-brand accent-brand focus:ring-brand"
        />
        <span>{business.privacy.promotionsLabel}</span>
      </label>
    </div>

    <div
      data-submit-error
      hidden
      tabindex="-1"
      role="alert"
      class="rounded-2xl border border-brand/25 bg-brand-soft/35 p-4"
    >
      <p class="flex items-start gap-2 text-sm leading-relaxed text-brand-dark">
        <TriangleExclamationPoint class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
        <span data-submit-error-text></span>
      </p>
    </div>
  </div>
</section>
