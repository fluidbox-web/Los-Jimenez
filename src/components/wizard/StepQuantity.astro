---
import { ArrowLeft, MessageCircle, Minus, Plus, Sparkles } from '@lucide/astro';
import { business } from '../../config/business';
import { calculateTotals, formatMXN } from '../../lib/pricing';
import { buildWhatsAppUrl } from '../../lib/whatsapp';

const initialTotals = calculateTotals(1, business.pricing.unitPrice, business.pricing.shippingFee);
const initialRemaining: number = business.availability.remaining;
const soldOut = initialRemaining <= 0;
const availabilityText =
  initialRemaining === 1
    ? 'Queda 1 platillo para hoy'
    : `Quedan ${initialRemaining} platillos para hoy`;
const helpUrl = buildWhatsAppUrl(
  business.whatsapp.number,
  'Hola, quiero saber cuándo habrá platillos disponibles.',
);
---

<section
  data-step-panel="2"
  hidden
  aria-labelledby="quantity-title"
  class="wizard-panel"
>
  <div class="mb-5 flex items-center justify-between gap-3">
    <button type="button" data-back class="step-back">
      <ArrowLeft class="size-4" aria-hidden="true" />
      Volver
    </button>
    <span class="eyebrow">Paso 2 · Cantidad</span>
  </div>
  <h2
    id="quantity-title"
    data-step-heading
    tabindex="-1"
    class="mt-3 font-display text-4xl font-semibold leading-[1.02] tracking-tight text-ink sm:text-5xl"
  >
    ¿Cuántos <em class="italic text-brand">platillos</em> quieres?
  </h2>

  <div class="mt-6 rounded-2xl border border-line bg-paper p-5 shadow-card">
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-muted">
        Disponibilidad de hoy
      </p>
      <p class="mt-2 font-display text-2xl font-semibold text-ink" aria-live="polite">
        <span data-availability-text>{availabilityText}</span>
      </p>
    </div>
  </div>

  <div data-quantity-content hidden={soldOut}>
    <div class="mt-5 rounded-[1.75rem] border border-line bg-paper p-5 shadow-card sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-5">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-muted">
            Tu cantidad
          </p>
          <div class="mt-3 flex items-center gap-4 sm:gap-5">
            <button
              type="button"
              data-qty-dec
              class="grid size-14 place-items-center rounded-full border border-line bg-cream/70 text-ink transition hover:border-ink/25 hover:bg-cream disabled:cursor-not-allowed disabled:opacity-35"
              aria-label="Quitar un platillo"
            >
              <Minus class="size-5" aria-hidden="true" />
            </button>

            <output
              data-quantity
              class="min-w-12 text-center font-display text-5xl font-semibold leading-none text-ink"
              aria-live="polite"
              aria-label="Cantidad de platillos"
            >
              1
            </output>

            <button
              type="button"
              data-qty-inc
              class="grid size-14 place-items-center rounded-full bg-olive text-cream transition hover:bg-olive-dark disabled:cursor-not-allowed disabled:opacity-35"
              aria-label="Agregar un platillo"
            >
              <Plus class="size-5" aria-hidden="true" />
            </button>
          </div>
        </div>

        <div class="rounded-2xl bg-cream/75 px-4 py-3 text-right">
          <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-ink-muted">
            Máximo
          </p>
          <p class="mt-1 font-display text-2xl font-semibold text-ink">
            <span data-remaining>{initialRemaining}</span>
          </p>
          <p class="text-[10px] text-ink-muted">disponibles</p>
        </div>
      </div>

      <p data-error-for="quantity" class="field-error" hidden></p>
    </div>

    <div class="mt-5 rounded-[1.75rem] bg-olive p-5 text-cream shadow-card sm:p-6">
      <div class="flex items-center gap-2">
        <Sparkles class="size-4 text-gold" aria-hidden="true" />
        <h3 class="font-display text-lg font-semibold text-cream">Tu desglose</h3>
      </div>

      <dl class="mt-4 space-y-2.5 text-sm">
        <div class="summary-row text-cream/70">
          <dt>Platillos <span data-summary-quantity>1</span> × {formatMXN(business.pricing.unitPrice)}</dt>
          <dd data-subtotal class="font-semibold text-cream">{formatMXN(initialTotals.subtotal)}</dd>
        </div>
        <div class="summary-row text-cream/70">
          <dt>Envío por pedido</dt>
          <dd data-shipping class="font-semibold text-cream">{formatMXN(initialTotals.shipping)}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4 border-t border-cream/15 pt-3">
          <dt class="font-display text-lg font-semibold text-cream">Total</dt>
          <dd data-total class="font-display text-3xl font-semibold text-cream">
            {formatMXN(initialTotals.total)}
          </dd>
        </div>
      </dl>

      <p class="mt-3 text-[11px] leading-relaxed text-cream/70">
        El envío de {formatMXN(business.pricing.shippingFee)} se cobra una sola vez, sin importar
        cuántos platillos agregues.
      </p>
    </div>
  </div>

  <div
    data-quantity-soldout
    hidden={!soldOut}
    class="mt-5 rounded-[1.75rem] border border-brand/20 bg-paper p-6"
    role="status"
  >
    <p class="font-display text-2xl font-semibold text-ink">Hoy ya no quedan platillos</p>
    <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-muted">
      El platillo del día se agotó. Escríbenos si quieres que te avisemos cuando haya
      disponibilidad de nuevo.
    </p>
    {
      helpUrl && (
        <a
          href={helpUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary mt-5"
        >
          <MessageCircle class="size-4 text-brand" aria-hidden="true" />
          Escribir por WhatsApp
        </a>
      )
    }
  </div>
</section>
